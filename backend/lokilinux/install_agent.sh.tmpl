#!/bin/bash
# LokiLinux Agent — Installation & Enrollment Script (served by the control plane).
# Usage: curl -fsSL <platform>/api/v1/agent/install.sh | bash -s -- --token=TOKEN [--url=URL] [--name=NAME]
set -euo pipefail

PLATFORM_URL="__PLATFORM_URL__"
ENROLLMENT_TOKEN=""
AGENT_NAME=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --token=*) ENROLLMENT_TOKEN="${1#*=}"; shift ;;
    --token)   ENROLLMENT_TOKEN="$2";      shift 2 ;;
    --name=*)  AGENT_NAME="${1#*=}";       shift ;;
    --name)    AGENT_NAME="$2";            shift 2 ;;
    --url=*)   PLATFORM_URL="${1#*=}";     shift ;;
    --url)     PLATFORM_URL="$2";          shift 2 ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

if [ -z "$ENROLLMENT_TOKEN" ]; then
  echo "Error: --token=ENROLLMENT_TOKEN required"; exit 1
fi
if [ "$(id -u)" -ne 0 ]; then
  echo "Error: run as root (sudo)"; exit 1
fi

# ── OS / arch detection ───────────────────────────────────────────────────────
[ -f /etc/os-release ] || { echo "Error: /etc/os-release not found"; exit 1; }
# shellcheck disable=SC1091
. /etc/os-release
OS="$ID"; OS_VERSION="${VERSION_ID:-unknown}"
ARCH="$(uname -m)"
[ "$ARCH" = "aarch64" ] && ARCH="arm64"
[ "$ARCH" = "x86_64" ]  && ARCH="amd64"

# Only tar.gz is currently built on the control plane — universal, extract manually.
PKG_FMT="tar.gz"

echo "[*] LokiLinux Agent Installation"
echo "    Platform : $PLATFORM_URL"
echo "    OS       : $OS $OS_VERSION ($ARCH)"

# ── Download + verify + extract binary ────────────────────────────────────────
echo "[*] Downloading agent package ($PKG_FMT/$ARCH)..."
TMPDIR_DL="$(mktemp -d)"
trap 'rm -rf "$TMPDIR_DL"' EXIT
curl -fsSL -H "Authorization: Bearer $ENROLLMENT_TOKEN" \
  "$PLATFORM_URL/api/v1/agent/download?os=$PKG_FMT&arch=$ARCH" \
  -o "$TMPDIR_DL/agent.tar.gz"

# Signature verification (plan P9): the platform signs the ASCII string
# "sha256:<hex digest of artifact>" with its Ed25519 key; a checksum alone
# only detects corruption, not a compromised distribution path. Verification
# failure = hard abort, never install.
SIG_URL="$PLATFORM_URL/api/v1/agent/download-sig?os=$PKG_FMT&arch=$ARCH"
PEM_URL="$PLATFORM_URL/api/v1/agent/signing-key.pem"
if curl -fsSL "$SIG_URL" -o "$TMPDIR_DL/agent.tar.gz.sig" 2>/dev/null \
   && [ -s "$TMPDIR_DL/agent.tar.gz.sig" ] \
   && curl -fsSL "$PEM_URL" -o "$TMPDIR_DL/signing.pub.pem" 2>/dev/null \
   && [ -s "$TMPDIR_DL/signing.pub.pem" ]; then
  DIGEST="$(sha256sum "$TMPDIR_DL/agent.tar.gz" | cut -d' ' -f1)"
  printf 'sha256:%s' "$DIGEST" > "$TMPDIR_DL/signed_input"
  if openssl pkeyutl -verify -pubin -inkey "$TMPDIR_DL/signing.pub.pem" -rawin \
        -sigfile "$TMPDIR_DL/agent.tar.gz.sig" -in "$TMPDIR_DL/signed_input" >/dev/null 2>&1; then
    echo "[+] Package signature verified"
  else
    echo "Error: package signature verification FAILED — refusing to install" >&2
    exit 1
  fi
else
  echo "[!] WARNING: signature file unavailable — installing WITHOUT cryptographic verification"
fi

tar -xzf "$TMPDIR_DL/agent.tar.gz" -C "$TMPDIR_DL"
AGENT_BIN="$(find "$TMPDIR_DL" -type f -name 'lokilinux-agent*' | head -1)"
[ -n "$AGENT_BIN" ] || { echo "Error: binary not found in package"; exit 1; }
chmod +x "$AGENT_BIN"
LOKI_CLI="$(find "$TMPDIR_DL" -type f -name 'loki' | head -1)"
[ -n "$LOKI_CLI" ] && chmod +x "$LOKI_CLI"
echo "[+] Binary extracted"

# ── Register with control plane ───────────────────────────────────────────────
echo "[*] Registering agent..."
REG=$(curl -fsSL -X POST "$PLATFORM_URL/api/v1/agents/register" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer $ENROLLMENT_TOKEN" \
  -d "{\"hostname\":\"$(hostname -f 2>/dev/null || hostname)\",\"os_distro\":\"$OS\",\"os_version\":\"$OS_VERSION\",\"arch\":\"$ARCH\",\"kernel_version\":\"$(uname -r)\"}")

get_field() { echo "$REG" | python3 -c "import sys,json;print(json.load(sys.stdin).get('$1',''))"; }
AGENT_ID="$(get_field agent_id)"
AGENT_CERT="$(get_field agent_cert)"
AGENT_KEY="$(get_field agent_key)"
CA_CERT="$(get_field ca_cert)"
[ -n "$AGENT_ID" ] || { echo "Error: registration failed: $REG"; exit 1; }
echo "[+] Registered — Agent ID: $AGENT_ID"

# ── Directories + certs ───────────────────────────────────────────────────────
install -d -m 750 /etc/lokilinux/certs
install -d -m 755 /var/lib/lokilinux /var/log/lokilinux /opt/lokilinux/plugins
printf '%s\n' "$AGENT_CERT" > /etc/lokilinux/certs/agent.crt
printf '%s\n' "$CA_CERT"    > /etc/lokilinux/certs/ca.crt
printf '%s\n' "$AGENT_KEY"  > /etc/lokilinux/certs/agent.key
chmod 600 /etc/lokilinux/certs/agent.key
chmod 644 /etc/lokilinux/certs/agent.crt /etc/lokilinux/certs/ca.crt

# ── Platform job-signing public key(s) ────────────────────────────────────────
# Public by design (only the private half, on the control plane, is secret).
# Fetched BEFORE agent.yaml so the versioned map can be embedded directly —
# a rotation via the admin KMS endpoints then reaches agents enrolling AFTER
# it, not just the ones already enrolled. Failure is non-fatal: agent runs
# with signed-jobs OFF and logs a warning per unsigned privileged job until
# a key lands.
echo "[*] Fetching platform job-signing public key(s)..."
SIGNING_KEYS_JSON="$(curl -fsSL "$PLATFORM_URL/api/v1/agent/signing-keys" 2>/dev/null || true)"
SIGNING_PUB_KEYS_YAML=""
SIGNING_KEY_B64=""
if [ -n "$SIGNING_KEYS_JSON" ]; then
  while IFS= read -r pair; do
    [ -n "$pair" ] || continue
    ver="$(printf '%s' "$pair" | sed -E 's/^"([0-9]+)".*/\1/')"
    b64="$(printf '%s' "$pair" | sed -E 's/.*:[[:space:]]*"([^"]*)"$/\1/')"
    SIGNING_PUB_KEYS_YAML="${SIGNING_PUB_KEYS_YAML}    ${ver}: \"${b64}\"
"
    [ "$ver" = "1" ] && SIGNING_KEY_B64="$b64"
  done < <(printf '%s' "$SIGNING_KEYS_JSON" | grep -oE '"[0-9]+"[[:space:]]*:[[:space:]]*"[^"]*"')
fi
if [ -z "$SIGNING_PUB_KEYS_YAML" ]; then
  # /signing-keys unreachable/empty (older platform) — fall back to the
  # single-key endpoint every prior installer version already used.
  SIGNING_KEY_B64="$(curl -fsSL "$PLATFORM_URL/api/v1/agent/signing-key" 2>/dev/null || true)"
  [ -n "$SIGNING_KEY_B64" ] && SIGNING_PUB_KEYS_YAML="    1: \"${SIGNING_KEY_B64}\"
"
fi
if [ -n "$SIGNING_KEY_B64" ]; then
  printf '%s' "$SIGNING_KEY_B64" > /etc/lokilinux/signing_pub.b64
  chmod 644 /etc/lokilinux/signing_pub.b64
else
  echo "[!] WARNING: could not fetch signing key — signed-job enforcement will stay disabled"
fi

SECURITY_YAML="security:
  enforce_signed_jobs: false
  signing_pub_key_path: /etc/lokilinux/signing_pub.b64"
if [ -n "$SIGNING_PUB_KEYS_YAML" ]; then
  SECURITY_YAML="${SECURITY_YAML}
  signing_pub_keys:
${SIGNING_PUB_KEYS_YAML}"
fi

# ── agent.yaml — schema MUST match agent/internal/config/config.go ─────────────
# gRPC is a separate mTLS port (50051); derive host from the platform URL
# (strip scheme + any http port), keep the standard gRPC port.
GRPC_HOST="$(echo "$PLATFORM_URL" | sed -E 's#^https?://##; s#[:/].*$##')"
POLICY_DIR="/var/lib/lokilinux/policy"
install -d -m 700 "$POLICY_DIR"
cat > /etc/lokilinux/agent.yaml <<EOF
platform:
  url: $PLATFORM_URL
  grpc_endpoint: $GRPC_HOST:50051
identity:
  agent_id: $AGENT_ID
  cert_path: /etc/lokilinux/certs/agent.crt
  key_path: /etc/lokilinux/certs/agent.key
  ca_path: /etc/lokilinux/certs/ca.crt
heartbeat:
  interval_sec: 60
cache:
  sqlite_db: /var/lib/lokilinux/agent.db
job_execution:
  timeout_seconds: 3600
$SECURITY_YAML
logging:
  level: info
file_integrity:
  watch_paths: []
  ignore_paths: []
policy:
  enabled: true
  state_dir: $POLICY_DIR
  trusted_keys:
    policy-signing-v1: "$(curl -fsSL "$PLATFORM_URL/api/v1/agent/policy-signing-key" 2>/dev/null || echo '')"
EOF
chmod 640 /etc/lokilinux/agent.yaml

# ── Install binary + CLI + systemd unit ───────────────────────────────────────
install -m 755 "$AGENT_BIN" /usr/local/bin/lokilinux-agent
if [ -n "$LOKI_CLI" ]; then
  install -m 755 "$LOKI_CLI" /usr/local/bin/loki
  # /usr/local/bin isn't guaranteed to be on PATH (some hosts override root's
  # PATH via .bashrc/profile.d, dropping it) — symlink into /usr/bin too,
  # which every observed PATH includes.
  ln -sf /usr/local/bin/loki /usr/bin/loki
fi
# ── Dedicated service user ────────────────────────────────────────────────────
# Pre-provisions the loki-agent identity. The service still runs as root for
# now (host-mutating jobs need a privilege bridge — see
# docs/security/EXECUTION_MODEL.md "Privilege bridge"); the user exists so the
# Faza 2 broker can adopt it without a re-install and state ownership is ready.
if ! id -u loki-agent >/dev/null 2>&1; then
  echo "[*] Creating system user loki-agent..."
  useradd --system --home-dir /var/lib/lokilinux --no-create-home \
          --shell /usr/sbin/nologin loki-agent 2>/dev/null || true
fi
chown -R loki-agent:loki-agent /var/lib/lokilinux /var/log/lokilinux 2>/dev/null || true

# NOTE: this is the canonical unit — served live via /api/v1/agent/install.sh
# (agent_install.py). Keep the [Service] section identical to
# scripts/install-agent.sh's copy (secondary/offline install path); the two
# diverged once already and it shipped a fix that never reached real hosts.
# ProtectSystem=strict/ReadWritePaths stay narrow: host-mutating jobs escape
# this sandbox per-job via systemd-run instead of needing writable paths
# here (see agent/internal/modules/systemd_run.go) — ReadWritePaths can't
# cover it anyway, since package installs write into /usr, not just
# /var/log or /var/cache.
#
# Hardening directives below are verified-safe for THIS unit's actual
# functionality (heartbeat gRPC + telemetry + per-job systemd-run).
# PrivateDevices/MemoryDenyWriteExecute — live-verified 2026-08-27 on Rocky
# Linux 9.8 (devapp.mishka.md, systemd 252): agent stable across 4 heartbeat
# cycles under both directives (NRestarts=0), signed-job E2E 8/8 unaffected.
# See docs/security/DISTRO_RUNBOOK.md. Ubuntu 22.04/24.04 remain untested —
# no VM access in the environment that ran this verification.
#
# Directive deliberately NOT set, with reason:
#   RestrictAddressFamilies — would break AF_NETLINK consumers in job units'
#     toolchains if inherited patterns change; revisit with Faza 2.
cat > /etc/systemd/system/lokilinux-agent.service <<'EOF'
[Unit]
Description=LokiLinux Agent
Documentation=https://docs.lokilinux.io/agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/lokilinux-agent --config /etc/lokilinux/agent.yaml
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lokilinux-agent
UMask=0027
ProtectSystem=strict
# /etc/lokilinux/certs is writable too — PKI Faza 4: the agent renews its own
# mTLS cert+key here in place (atomic tmp+rename, cert_renewal.go) before the
# current one expires. Everything else stays narrow per the comment above.
ReadWritePaths=/var/lib/lokilinux /var/log/lokilinux /etc/lokilinux/certs
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
PrivateDevices=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
EOF

# ── Exec broker (opt-in non-root core) ────────────────────────────────────────
# INSTALL_EXEC_BROKER=0 keeps the legacy all-root layout (compat default).
# With the broker, the main agent can run as loki-agent; telemetry paths that
# still need systemd-run are documented in EXECUTION_MODEL.md as a known gap.
if [ "${INSTALL_EXEC_BROKER:-1}" = "1" ] && [ -x /usr/local/bin/loki-agent-exec ]; then
  install -m 644 /dev/null /etc/systemd/system/loki-agent-exec.service
  cat > /etc/systemd/system/loki-agent-exec.service <<'BROKEREOF'
[Unit]
Description=LokiLinux Agent Execution Broker
PartOf=lokilinux-agent.service
After=lokilinux-agent.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/loki-agent-exec --socket /run/lokilinux/exec.sock --agent-user loki-agent
Restart=always
RestartSec=5
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectSystem=strict
ReadWritePaths=/run/lokilinux /var/lib/lokilinux
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
PrivateDevices=true
MemoryDenyWriteExecute=true
UMask=0027
TasksMax=64

[Install]
WantedBy=multi-user.target
BROKEREOF
  mkdir -p /run/lokilinux
  chown root:loki-agent /run/lokilinux 2>/dev/null || true
  chmod 750 /run/lokilinux
fi

# Non-root flip: when the broker is installed AND explicitly requested via
# AGENT_NON_ROOT=1, the core runs as loki-agent — privileged ops go through
# the broker socket. Default stays root (compat) until a fleet is validated.
if [ -f /etc/systemd/system/loki-agent-exec.service ] && [ "${AGENT_NON_ROOT:-0}" = "1" ]; then
  echo "[*] AGENT_NON_ROOT=1: switching agent core to User=loki-agent"
  sed -i 's/^User=root$/User=loki-agent/' /etc/systemd/system/lokilinux-agent.service
  chown -R loki-agent:loki-agent /var/lib/lokilinux /var/log/lokilinux
  chown root:loki-agent /etc/lokilinux/certs/agent.key 2>/dev/null || true
  chmod 640 /etc/lokilinux/certs/agent.key 2>/dev/null || true
  # Renewal (PKI Faza 4) atomic-renames a new agent.key.tmp into place — that
  # needs write on the DIRECTORY itself, not just the file.
  chown root:loki-agent /etc/lokilinux/certs
  chmod 770 /etc/lokilinux/certs
fi

systemctl daemon-reload
systemctl enable lokilinux-agent >/dev/null 2>&1 || true
if [ -f /etc/systemd/system/loki-agent-exec.service ]; then
  systemctl enable --now loki-agent-exec >/dev/null 2>&1 || true
fi
systemctl restart lokilinux-agent

sleep 2
if systemctl is-active --quiet lokilinux-agent; then
  echo "[+] lokilinux-agent running — ID: $AGENT_ID"
  [ -x /usr/local/bin/loki ] && echo "[+] loki CLI installed — try: loki status"
else
  echo "[-] Service failed to start:"; journalctl -u lokilinux-agent -n 20 --no-pager; exit 1
fi
