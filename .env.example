# =============================================================================
# LokiLinux — Environment Configuration Template
# Copy to .env and fill in all required values before running docker compose up
# Generate secrets: openssl rand -base64 48
# =============================================================================

# =============================================================================
# PLATFORM IDENTITY
# =============================================================================

ENVIRONMENT=production
PLATFORM_HOSTNAME=lokilinux.example.com
LOKILINUX_VERSION=0.3.0

# Public URL agents and browsers use to reach the platform. Drives the generated
# agent install command and CORS origin. Default when unset: http://localhost:3000
# Leave unset for zero-config — the /agents page builds install commands from the
# browser origin instead; set it only for a fixed canonical URL (headless/API-first).
#PUBLIC_URL=https://lokilinux.example.com

# =============================================================================
# DATABASE — PostgreSQL 15 (via TimescaleDB image)
# =============================================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lokilinux
POSTGRES_USER=lokilinux
POSTGRES_PASSWORD=change_this_to_a_strong_password

# =============================================================================
# TIMESCALEDB — metrics database (same container, separate DB)
# TimescaleDB chunk_time_interval = '1 day' for agent_metrics hypertable
# =============================================================================

TIMESCALE_HOST=postgres
TIMESCALE_PORT=5432
TIMESCALE_DB=lokilinux_metrics
TIMESCALE_USER=metrics_user
TIMESCALE_PASSWORD=change_this_to_a_strong_password

# =============================================================================
# CONNECTION POOLER — pgBouncer
# =============================================================================

PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# =============================================================================
# CACHE — Redis 7
# =============================================================================

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change_this_to_a_strong_password
REDIS_MAXMEMORY=2gb

# =============================================================================
# MESSAGE BUS — NATS 2.10 with JetStream
# Topics use prefix: lokilinux.<resource>.<event>
#   e.g. lokilinux.agent.<id>.heartbeat
#        lokilinux.policy.changed
#        lokilinux.cve.database.updated
# =============================================================================

# NATS auth is MANDATORY (security audit CR-02) — broker starts with
# --user/--pass and every client URL must carry the credentials.
NATS_USER=lokilinux
NATS_PASSWORD=change_this_to_a_strong_random_password
NATS_URL=nats://lokilinux:${NATS_PASSWORD}@nats:4222

# =============================================================================
# AUTHENTICATION — Better Auth
# No JWT vars — Better Auth manages sessions natively.
# Generate BETTER_AUTH_SECRET: openssl rand -base64 48
# =============================================================================

BETTER_AUTH_SECRET=change_this_to_a_random_64_char_secret
BETTER_AUTH_URL=http://localhost:3000
# lokilinux-api/lokilinux-migrate fetch JWKS from inside their own container,
# where "localhost" would point at themselves — override only if the
# frontend service is reachable under a different internal name.
# BETTER_AUTH_INTERNAL_URL=http://lokilinux-frontend:3000

# =============================================================================
# gRPC / AGENT COMMUNICATION (mTLS)
# =============================================================================

GRPC_PORT=50051
AGENT_CERT_DIR=/etc/lokilinux/certs

# Server certificate paths (inside container)
CA_CERT_PATH=/etc/lokilinux/certs/ca.crt
CA_KEY_PATH=/etc/lokilinux/certs/ca.key
SERVER_CERT_PATH=/etc/lokilinux/certs/server.crt
SERVER_KEY_PATH=/etc/lokilinux/certs/server.key

CERT_VALIDITY_DAYS=365
CERT_RENEWAL_DAYS=30

# =============================================================================
# PLUGIN SYSTEM
# =============================================================================

PLUGIN_DIR=/opt/lokilinux/plugins
PLUGINS_ENABLED=true
PLUGINS_SANDBOX_MODE=true
PLUGINS_MAX_MEMORY_MB=256
PLUGINS_MAX_CPU_CORES=1

# =============================================================================
# AGENT BEHAVIOUR
# =============================================================================

AGENT_HEARTBEAT_INTERVAL=60
AGENT_HEARTBEAT_TIMEOUT=30
AGENT_MAX_OFFLINE_DAYS=30
AGENT_REGISTRATION_TOKEN_TTL=3600

# =============================================================================
# FRONTEND
# =============================================================================

FRONTEND_URL=https://lokilinux.example.com

# =============================================================================
# CVE FEEDS
# =============================================================================

CVE_FEED_UPDATE_INTERVAL=86400
CVE_FEED_SOURCES=ubuntu,debian,rhel,nvd
NVD_API_KEY=

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=info
LOG_FORMAT=json
DEBUG=false

# =============================================================================
# NOTIFICATIONS (optional)
# =============================================================================

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@lokilinux.example.com

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# =============================================================================
# STORAGE
# =============================================================================

BACKUP_DIR=/var/backups/lokilinux
BACKUP_RETENTION_DAYS=30

S3_BACKUP_ENABLED=false
S3_BUCKET=lokilinux-backups
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://s3.amazonaws.com
